rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================================ PÚBLICAS ================================
    // Solo lectura. Sin autenticación. Sin escritura desde el cliente.
    match /noticias/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /catalogo_planes/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /sucursalesHorarios/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /guiasPortal/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /filtroMarca/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /grillaCanales/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Si decides que "conocimiento_portal" es parte del chatbot público,
    // comenta las líneas de abajo y descomenta la alternativa más abajo.
    match /conocimiento_portal/{id} {
      allow read, write: if request.auth != null;
    }

    // match /conocimiento_portal/{id} {
    //   allow read: if true;
    //   allow write: if false;
    // }

    // ================================ PRIVADAS ================================
    // Requieren autenticación (Firebase Auth). Sin auth = acceso denegado.
    
    // ============ FORMULARIOS PÚBLICOS (Escritura sin auth) ============
    // Migraciones, No acepta fibra, Ventas Isla
    // Permiten escritura pública desde /formularios pero con validación básica
    match /migraciones/{id} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.keys().hasAll(['asesor', 'rutCliente', 'fechaIngreso', 'creado'])
                    && request.resource.data.asesor is string
                    && request.resource.data.rutCliente is string
                    && request.resource.data.fechaIngreso is string;
      allow update, delete: if request.auth != null;
    }

    match /no_acepta_fibra/{id} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.keys().hasAll(['asesor', 'rutCliente', 'fecha', 'motivoNoAcepta', 'creado'])
                    && request.resource.data.asesor is string
                    && request.resource.data.rutCliente is string
                    && request.resource.data.fecha is string
                    && request.resource.data.motivoNoAcepta is string;
      allow update, delete: if request.auth != null;
    }

    match /no_venta_islas_movil/{id} {
      allow read: if request.auth != null;
      allow create: if request.resource.data.keys().hasAll(['asesor', 'rutCliente', 'fecha', 'estado', 'creado'])
                    && request.resource.data.asesor is string
                    && request.resource.data.rutCliente is string
                    && request.resource.data.fecha is string
                    && request.resource.data.estado is string;
      allow update, delete: if request.auth != null;
    }

    match /tipificaciones_bloc/{id} {
      allow read, write: if request.auth != null;
    }

    match /admins_autorizados/{email} {
      // Lectura para cualquier usuario autenticado
      allow read: if request.auth != null;
      // Escritura: el admin principal, los admins ya registrados,
      // o nuevos correos dentro de los dominios permitidos.
      allow write: if (
        request.auth.token.email == 'adriangamervc@gmail.com' ||
        exists(/databases/$(database)/documents/admins_autorizados/$(request.auth.token.email)) ||
        (
          request.resource.data.email != '' &&
          (request.resource.data.email.endsWith('@apexamerica.com') ||
           request.resource.data.email.endsWith('@clarovtr.cl'))
        )
      );
    }

    match /messenger_chats/{chatId} {
      allow read, write: if request.auth != null;
    }

    match /messenger_chats/{chatId}/mensajes/{msgId} {
      allow read, write: if request.auth != null;
    }

    match /mis_stickers/{id} {
      allow read, write: if request.auth != null;
    }

    match /messenger_stickers/{id} {
      allow read, write: if request.auth != null;
    }

    match /apex_memoria/{id} {
      allow read, write: if request.auth != null;
    }

    match /apex_aprendizaje/{id} {
      allow read, write: if request.auth != null;
    }

    // Perfil de administrador (avatar, etc.)
    match /adminProfile/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Lectores y lecturas
    match /lectores/{id} {
      allow read, write: if request.auth != null;
    }

    match /lecturas/{id} {
      allow read, write: if request.auth != null;
    }

    // El resto de colecciones NO tiene regla aceptada, por lo que Firestore
    // las niega automáticamente (incluidos corpus, training_examples, etc.).
  }
}

