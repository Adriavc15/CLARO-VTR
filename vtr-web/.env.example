# Copia a .env.local y rellena con tus claves de https://www.themoviedb.org/settings/api
VITE_TMDB_ACCESS_TOKEN=
VITE_TMDB_API_KEY=

# Servidor EmulatorJS Netplay (HTTPS/WSS). Ej: https://vtr-netplay-xxxxx.run.app/
VITE_NETPLAY_SERVER=

# GIFs del chat (opcional). Sin clave usa un pack local.
# Giphy: https://developers.giphy.com/dashboard/
VITE_GIPHY_API_KEY=
# Tenor (Google Cloud): https://developers.google.com/tenor/guides/quickstart
VITE_TENOR_API_KEY=
